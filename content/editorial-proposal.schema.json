{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "baseCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "title": {
      "type": "string",
      "minLength": 10,
      "maxLength": 200
    },
    "humanReviewRequired": {
      "type": "boolean",
      "const": true
    },
    "sources": {
      "minItems": 1,
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "retrievedAt": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          }
        },
        "required": ["title", "url", "retrievedAt"],
        "additionalProperties": false
      }
    },
    "changes": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "chapterId": {
            "type": "string"
          },
          "rationale": {
            "type": "string",
            "minLength": 50
          },
          "markdown": {
            "type": "string",
            "minLength": 2000,
            "maxLength": 100000
          }
        },
        "required": ["chapterId", "rationale", "markdown"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "id",
    "baseCommit",
    "title",
    "humanReviewRequired",
    "sources",
    "changes"
  ],
  "additionalProperties": false
}
